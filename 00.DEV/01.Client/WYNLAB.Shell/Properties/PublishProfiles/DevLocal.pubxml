<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <!-- ProdLocal.pubxml과 거의 같은 구조 - InstallUrl은 이 PC 자신(localhost:8091)을
         가리킨다. 개발 PC에서 D:\WYNLAB_SVC\ClickOnce\로 직접 게시해서 테스트할 때 쓴다.
         평소 개발(F5 디버그)에는 필요 없고, ClickOnce 설치/자동업데이트 흐름 자체를 로컬에서
         검증하고 싶을 때만 쓰면 된다.

         Configuration은 Release가 아니라 Debug다 - WYNLAB.Shell.csproj의 appsettings 선택
         조건(Debug->appsettings.Dev.json, Release->appsettings.Prod.json)과 맞물려서, Debug라야
         appsettings.Dev.json(Environments.Development가 진짜 localhost:8090/8091을 가리킴)이
         게시물에 들어간다. Release로 두면(예전 설정) appsettings.Prod.json이 들어가서, 이 PC의
         D:\WYNLAB_SVC가 아니라 회사 서버(192.168.160.10)를 바라보는 셸이 게시된다 - 로컬에만
         Api가 떠 있고 회사 서버가 안 열려 있을 때 로그인 자체가 안 되는 원인이었다(실제로 겪음).
         Deploy-Local.ps1도 이 프로필을 쓸 때 /p:Configuration=Debug를 같이 넘긴다(둘 다
         맞춰둬야 MSBuild 커맨드라인 인자가 이 값을 덮어쓰지 않는다). -->
    <PublishProtocol>ClickOnce</PublishProtocol>
    <GenerateManifests>true</GenerateManifests>
    <SignManifests>false</SignManifests>
    <InstallUrl>http://localhost:8091/</InstallUrl>
    <Configuration>Debug</Configuration>
    <ProductName>WYN LAB</ProductName>
    <PublisherName>[회사명]</PublisherName>
    <ApplicationVersion>1.0.0.*</ApplicationVersion>
    <Install>true</Install>
    <UpdateEnabled>true</UpdateEnabled>
    <UpdateMode>Foreground</UpdateMode>
    <MapFileExtensions>true</MapFileExtensions>
  </PropertyGroup>
</Project>
