<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <!-- Prod.pubxml과 내용은 같은데, 서버로 직접 업로드하는 대신 이 리포 옆의 로컬 폴더에
         게시해서 그 결과물을 수동으로 서버(D:\WYNLAB\ClickOnce\)에 복사하는 용도.
         PublishUrl(파일이 실제로 쓰여지는 위치)만 로컬 폴더로 바꾸고, InstallUrl(게시물 안에
         박히는 "여기서 설치/업데이트 확인해라" 주소)은 실제 서버 주소 그대로 둬야 한다 -
         이 두 개는 원래 별개 설정이라 로컬에 게시해도 클라이언트는 정상적으로 서버 주소로
         업데이트를 확인하러 간다. -->
    <PublishUrl>..\..\..\_publish\ClickOnce\Prod\</PublishUrl>
    <InstallUrl>http://192.168.160.10:8091/</InstallUrl>
    <Configuration>Release</Configuration>
    <ProductName>WYN LAB</ProductName>
    <PublisherName>[회사명]</PublisherName>
    <ApplicationVersion>1.0.0.*</ApplicationVersion>
    <Install>true</Install>
    <UpdateEnabled>true</UpdateEnabled>
    <UpdateMode>Foreground</UpdateMode>
    <MapFileExtensions>false</MapFileExtensions>
  </PropertyGroup>
</Project>
