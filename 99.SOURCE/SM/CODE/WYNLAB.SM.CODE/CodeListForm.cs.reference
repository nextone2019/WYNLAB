using DevExpress.XtraEditors;
using DevExpress.XtraEditors.Controls;
using DevExpress.XtraGrid.Views.Base;
using WYNLAB.Shared.Dtos;
using WYNLAB.Base;
using WYNLAB.Base.Controls;
using System.Drawing;

namespace WYNLAB.SM.CODE;

/// <summary>
/// 기초코드등록 화면(TSMMAJOR 대분류/TSMMINOR 소분류). 좌측에 대분류 리스트, 우측 상단에
/// 대분류 상세 입력폼(관리항목1~10 포함), 우측 하단에 소분류 그리드(인라인 편집) -
/// MenuListForm(좌측 리스트+우측 인라인편집)과 같은 골격에 소분류 그리드만 하나 더 붙은 구조.
///
/// 고정 배치(검색패널/대분류 기본필드/그리드/버튼)는 CodeListForm.Designer.cs에서 VS 디자이너로
/// 편집 가능하게 관리한다. 관리항목1~10은 10번 반복되는 패턴이라 디자이너가 표현할 수 없어서
/// (루프 자체를 디자이너 캔버스에 그릴 방법이 없음) 여기 BuildManagedItems()에 코드로 남겼다 -
/// 그리드 컬럼/데이터바인딩도 마찬가지로 데이터 흐름과 얽혀있어 코드로 두는 게 유지보수하기 낫다.
///
/// Shell 툴바 연결: 조회=QueryClick, 입력=NewClick(신규 대분류 입력모드),
/// 저장=SaveClick(대분류+소분류 그리드를 한 번에 저장), 행추가/행삭제=소분류 그리드 행 조작.
/// 대분류 자체는 TSMMAJOR에 사용여부(USE_YN) 컬럼이 없어 소프트삭제를 지원하지 않는다 -
/// DeleteClick은 안내 메시지만 띄운다.
/// </summary>
public partial class CodeListForm : BaseForm
{
    private const int RelCount = 10;

    private List<MajorListItemDto> _majors = new();
    private List<MinorItemDto> _minors = new();
    private string? _editingMajorCd; // null이면 신규모드

    // 관리항목1~10 - BuildManagedItems()가 루프로 생성해서 detailScroll에 직접 추가한다.
    private readonly TextEditWyn[] txtRelTitle = new TextEditWyn[RelCount];
    private readonly ComboBoxEdit[] cboRelCdType = new ComboBoxEdit[RelCount];
    private readonly TextEditWyn[] txtRelCd = new TextEditWyn[RelCount];

    public CodeListForm()
    {
        InitializeComponent();

        Text = "기초코드등록";
        MenuCd = "SM_CODE_BASE";

        BuildManagedItems();

        // Dock 추가 순서: InitializeComponent()가 Fill(splitContainer)/Top(검색패널)을 이미
        // 추가해뒀으니, 화면 타이틀바는 여기서 맨 마지막(=가장 위)에 추가한다.
        Controls.Add(BuildScreenHeader());

        EnterNewMode();
        Load += async (s, e) => await QueryClick();
    }

    /// <summary>
    /// 관리항목1~10을 2열 x 5행으로 detailScroll에 배치 - 동일한 패턴(제목/구분/코드 3개 입력)이
    /// 10번 반복이라 루프로 생성한다(디자이너로는 표현 불가, 클래스 상단 설명 참고).
    /// detailScroll 안 세로 좌표는 CodeListForm.Designer.cs의 고정 필드들(y=12~78)과
    /// 겹치지 않도록 98부터 시작하고, 비고 라벨(y=270)과도 겹치지 않게 끝난다(98 + 5*32 = 258).
    /// </summary>
    private void BuildManagedItems()
    {
        const int labelW = 76, colWidth = 340, startY = 98;

        for (var i = 0; i < RelCount; i++)
        {
            var col = i % 2;
            var row = i / 2;
            var x = 16 + col * colWidth;
            var itemY = startY + row * 32;

            var lbl = new LabelControl { Text = $"관리항목{i + 1}", Font = AppFonts.Caption, Location = new Point(x, itemY + 4), AutoSizeMode = LabelAutoSizeMode.None, Size = new Size(labelW, 18) };
            lbl.Appearance.ForeColor = Color.FromArgb(100, 100, 100);

            var title = new TextEditWyn { Font = AppFonts.Body, Location = new Point(x + labelW, itemY), Size = new Size(90, 24) };
            var type = new ComboBoxEdit { Font = AppFonts.Body, Location = new Point(x + labelW + 94, itemY), Size = new Size(64, 24) };
            type.Properties.Items.AddRange(new object[] { "", "CODE", "TEXT" });
            type.Properties.TextEditStyle = TextEditStyles.DisableTextEditor;
            var code = new TextEditWyn { Font = AppFonts.Body, Location = new Point(x + labelW + 162, itemY), Size = new Size(80, 24) };

            detailScroll.Controls.Add(lbl);
            detailScroll.Controls.Add(title);
            detailScroll.Controls.Add(type);
            detailScroll.Controls.Add(code);

            txtRelTitle[i] = title;
            cboRelCdType[i] = type;
            txtRelCd[i] = code;
        }
    }

    private void txtSearch_KeyDown(object? sender, KeyEventArgs e)
    {
        if (e.KeyCode != Keys.Enter) return;
        e.Handled = true;
        _ = QueryClick();
    }

    private async void btnSearch_Click(object? sender, EventArgs e) => await QueryClick();

    private void majorGridView_FocusedRowObjectChanged(object? sender, FocusedRowObjectChangedEventArgs e)
    {
        if (e.Row is MajorListItemDto major) EnterEditMode(major);
    }

    private void btnCancelEdit_Click(object? sender, EventArgs e) => EnterNewMode();

    private void detailScroll_Resize(object? sender, EventArgs e) =>
        btnCancelEdit.Location = new Point(detailScroll.Width - btnCancelEdit.Width - 16, 12);

    public override async Task QueryClick()
    {
        var query = $"api/codes?majorCd={Uri.EscapeDataString(txtSearchMajorCd.Text.Trim())}&majorNm={Uri.EscapeDataString(txtSearchMajorNm.Text.Trim())}&selectedMajorCd={Uri.EscapeDataString(_editingMajorCd ?? string.Empty)}";
        var result = await ApiClient.GetAsync<CodeQueryResponse>(query) ?? new();
        _majors = result.Majors;
        _minors = result.Minors;
        majorGrid.DataSource = _majors;
        minorGrid.DataSource = _minors;

        if (_editingMajorCd != null && _majors.All(m => m.major_cd != _editingMajorCd))
        {
            EnterNewMode();
        }
    }

    public override Task NewClick()
    {
        EnterNewMode();
        return Task.CompletedTask;
    }

    public override Task DeleteClick()
    {
        AppMessageBox.Show("대분류코드는 삭제(사용중지)를 지원하지 않습니다.", "안내");
        return Task.CompletedTask;
    }

    public override Task NewRowClick()
    {
        minorGridView.AddNewRow();
        return Task.CompletedTask;
    }

    public override Task DeleteRowClick()
    {
        var handle = minorGridView.FocusedRowHandle;
        if (handle >= 0) minorGridView.DeleteRow(handle);
        return Task.CompletedTask;
    }

    private void EnterNewMode()
    {
        _editingMajorCd = null;
        txtMajorCd.Text = string.Empty;
        txtMajorCd.Enabled = true;
        txtMajorNm.Text = string.Empty;
        chkSysYn.Checked = false;
        txtRemark.Text = string.Empty;
        for (var i = 0; i < RelCount; i++)
        {
            txtRelTitle[i].Text = string.Empty;
            cboRelCdType[i].SelectedItem = string.Empty;
            txtRelCd[i].Text = string.Empty;
        }
        lblFormTitle.Text = "신규 대분류코드 등록";
        _minors = new();
        minorGrid.DataSource = _minors;
        txtMajorCd.Focus();
    }

    private void EnterEditMode(MajorListItemDto major)
    {
        _editingMajorCd = major.major_cd;
        txtMajorCd.Text = major.major_cd;
        txtMajorCd.Enabled = false; // 대분류코드는 PK라 수정 불가
        txtMajorNm.Text = major.major_nm;
        chkSysYn.Checked = major.sys_yn;
        txtRemark.Text = major.remark;

        var titles = new[] { major.rel_title1, major.rel_title2, major.rel_title3, major.rel_title4, major.rel_title5, major.rel_title6, major.rel_title7, major.rel_title8, major.rel_title9, major.rel_title10 };
        var types = new[] { major.rel_cd_type1, major.rel_cd_type2, major.rel_cd_type3, major.rel_cd_type4, major.rel_cd_type5, major.rel_cd_type6, major.rel_cd_type7, major.rel_cd_type8, major.rel_cd_type9, major.rel_cd_type10 };
        var codes = new[] { major.rel_cd1, major.rel_cd2, major.rel_cd3, major.rel_cd4, major.rel_cd5, major.rel_cd6, major.rel_cd7, major.rel_cd8, major.rel_cd9, major.rel_cd10 };
        for (var i = 0; i < RelCount; i++)
        {
            txtRelTitle[i].Text = titles[i] ?? string.Empty;
            cboRelCdType[i].SelectedItem = types[i] ?? string.Empty;
            txtRelCd[i].Text = codes[i] ?? string.Empty;
        }

        lblFormTitle.Text = $"대분류 수정 - {major.major_nm}";

        // 소분류는 QueryClick이 selectedMajorCd로 다시 받아와야 정확하다(그리드에서 편집 중인
        // 내용을 잃더라도, 대분류를 바꿔 선택했다는 건 이전 미저장 소분류 변경은 버린다는 뜻).
        _ = QueryClick();
    }

    public override async Task SaveClick()
    {
        if (string.IsNullOrWhiteSpace(txtMajorCd.Text) || string.IsNullOrWhiteSpace(txtMajorNm.Text))
        {
            AppMessageBox.Show("대분류코드와 대분류명은 필수입니다.", "확인");
            return;
        }

        var request = new MajorSaveRequest
        {
            major_cd = txtMajorCd.Text,
            major_nm = txtMajorNm.Text,
            sys_yn = chkSysYn.Checked,
            remark = txtRemark.Text,
            rel_cd1 = txtRelCd[0].Text, rel_title1 = txtRelTitle[0].Text, rel_cd_type1 = (string?)cboRelCdType[0].SelectedItem,
            rel_cd2 = txtRelCd[1].Text, rel_title2 = txtRelTitle[1].Text, rel_cd_type2 = (string?)cboRelCdType[1].SelectedItem,
            rel_cd3 = txtRelCd[2].Text, rel_title3 = txtRelTitle[2].Text, rel_cd_type3 = (string?)cboRelCdType[2].SelectedItem,
            rel_cd4 = txtRelCd[3].Text, rel_title4 = txtRelTitle[3].Text, rel_cd_type4 = (string?)cboRelCdType[3].SelectedItem,
            rel_cd5 = txtRelCd[4].Text, rel_title5 = txtRelTitle[4].Text, rel_cd_type5 = (string?)cboRelCdType[4].SelectedItem,
            rel_cd6 = txtRelCd[5].Text, rel_title6 = txtRelTitle[5].Text, rel_cd_type6 = (string?)cboRelCdType[5].SelectedItem,
            rel_cd7 = txtRelCd[6].Text, rel_title7 = txtRelTitle[6].Text, rel_cd_type7 = (string?)cboRelCdType[6].SelectedItem,
            rel_cd8 = txtRelCd[7].Text, rel_title8 = txtRelTitle[7].Text, rel_cd_type8 = (string?)cboRelCdType[7].SelectedItem,
            rel_cd9 = txtRelCd[8].Text, rel_title9 = txtRelTitle[8].Text, rel_cd_type9 = (string?)cboRelCdType[8].SelectedItem,
            rel_cd10 = txtRelCd[9].Text, rel_title10 = txtRelTitle[9].Text, rel_cd_type10 = (string?)cboRelCdType[9].SelectedItem
        };

        var wasNew = _editingMajorCd == null;
        var result = wasNew
            ? await ApiClient.PostAsync<MajorSaveRequest, ApiResult>("api/codes", request)
            : await ApiClient.PutAsync<MajorSaveRequest, ApiResult>($"api/codes/{_editingMajorCd}", request);

        if (result == null || !result.Success)
        {
            AppMessageBox.Show(result?.Message ?? "저장에 실패했습니다.", "저장 실패");
            return;
        }

        var savedMajorCd = wasNew ? (result.GeneratedCode ?? request.major_cd) : _editingMajorCd!;

        minorGridView.CloseEditor();
        minorGridView.UpdateCurrentRow();
        var minorResult = await ApiClient.PutAsync<SaveMinorsRequest, ApiResult>(
            $"api/codes/{savedMajorCd}/minors", new SaveMinorsRequest { Items = _minors });

        if (minorResult == null || !minorResult.Success)
        {
            AppMessageBox.Show(minorResult?.Message ?? "소분류 저장에 실패했습니다.", "저장 실패");
            return;
        }

        _editingMajorCd = savedMajorCd;
        minorGridView.ClearDirtyMarks();
        await QueryClick();
        Toast.Show(wasNew ? "대분류코드가 등록되었습니다." : "수정되었습니다.");
    }
}
