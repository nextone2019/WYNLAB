      <HintPath>C:\Program Files (x86)\DevExpress 21.2\Components\Bin\Framework\DevExpress.XtraTreeList.v21.2.dll</HintPath>
    </Reference>
    <!-- frmItemMulti(품목일괄등록)의 엑셀 업로드(.xlsx 읽기)용 - 새 NuGet 패키지 없이 로컬에
         이미 설치된 DevExpress Office File API로 직접 읽는다(2026-09-16). ExportToXlsx(엑셀
         내보내기)는 DevExpress.XtraGrid/XtraPrinting에 이미 포함돼 있어 별도 참조가 필요
         없지만, 파일을 "읽는" 쪽은 이 두 dll이 필요하다 - 순수 Workbook 클래스(비UI)는 이
         PC에 설치된 Core dll에 없어서(리플렉션으로 확인함), 화면에 안 띄우는 SpreadsheetControl
         (XtraSpreadsheet.v21.2.dll)의 .Document(IWorkbook)로 대신 읽는다. -->
    <Reference Include="DevExpress.Spreadsheet.v21.2.Core">
      <HintPath>C:\Program Files (x86)\DevExpress 21.2\Components\Bin\Framework\DevExpress.Spreadsheet.v21.2.Core.dll</HintPath>
    </Reference>
    <Reference Include="DevExpress.XtraSpreadsheet.v21.2">
