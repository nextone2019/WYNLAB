<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>WYNLAB.Api</RootNamespace>
    <!-- IIS 호스팅용 -->
    <AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
    <UserSecretsId>803575cc-4e35-4433-b39f-dee9567ad3ee</UserSecretsId>
  </PropertyGroup>

  <!-- 게시(Publish)할 때 web.config의 ASPNETCORE_ENVIRONMENT가 자동으로 채워지도록 지정.
       이게 없으면 게시할 때마다 web.config가 초기화되어 매번 수동으로 편집해야 했음(과거 이슈).
       Debug 구성으로 게시 -> 개발서버(Development), Release로 게시 -> 운영서버(Production) -->
  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <EnvironmentName>Development</EnvironmentName>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <EnvironmentName>Production</EnvironmentName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.8" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <!-- 로깅/모니터링(2026-09-15) - 지금까지 운영에서 에러가 나도 서버 쪽에 아무 기록이 안
         남았다(개발환경에서만 예외 상세를 응답 바디로 내려줬을 뿐, 그마저도 로그 파일로는
         안 남겼음). 파일로 남기는 게 제일 단순하고 이 규모(단일 서버, 외부 로그 수집
         인프라 없음)에 맞는다 - ELK/Grafana 같은 걸 새로 들일 이유가 없다. -->
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <!-- 외부 API 연동 프레임워크(2026-09-15) - TSMAPIDEF.auth_key_enc를 Windows DPAPI로
         암호화하는 데 쓴다(ApiKeyProtector.cs). .NET에서 DPAPI는 이 패키지로 분리되어 있음. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\03.Shared\WYNLAB.Shared\WYNLAB.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Controllers\BA\" />
    <Folder Include="Controllers\MA\" />
    <Folder Include="Controllers\AP\" />
    <Folder Include="Controllers\HR\" />
    <Folder Include="Controllers\PR\" />
    <Folder Include="Controllers\SA\" />
    <Folder Include="Repositories\BA\" />
    <Folder Include="Repositories\HR\" />
    <Folder Include="Repositories\MA\" />
    <Folder Include="Repositories\AP\" />
    <Folder Include="Repositories\PR\" />
    <Folder Include="Repositories\SA\" />
  </ItemGroup>

</Project>
