<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>WYNLAB.SM.frmMinorCode</RootNamespace>
    <!-- SvgIcon처럼 문자열이 아닌(이미지 등) 리소스를 .resx에 넣으면 SDK 스타일 프로젝트는
         기본적으로 못 읽는다 - 이 옵션 + System.Resources.Extensions 패키지가 있어야 됨. -->
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Resources.Extensions" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- DevExpress 21.2 로컬 설치 기반 참조 -->
    <Reference Include="DevExpress.Data.v21.2">
      <HintPath>C:\Program Files (x86)\DevExpress 21.2\Components\Bin\Framework\DevExpress.Data.v21.2.dll</HintPath>
    </Reference>
    <!-- GridControl/GridView를 ISupportInitialize로 캐스트(BeginInit/EndInit, 디자이너 표준 패턴)
         하려면 필요 - Data.v21.2만으로는 GridControl의 전체 타입 계층(IControlRowSource 등)을
         컴파일러가 다 못 찾는다. -->
    <Reference Include="DevExpress.Data.Desktop.v21.2">
      <HintPath>C:\Program Files (x86)\DevExpress 21.2\Components\Bin\Framework\DevExpress.Data.Desktop.v21.2.dll</HintPath>
    </Reference>
    <Reference Include="DevExpress.Utils.v21.2">
      <HintPath>C:\Program Files (x86)\DevExpress 21.2\Components\Bin\Framework\DevExpress.Utils.v21.2.dll</HintPath>
    </Reference>
    <Reference Include="DevExpress.XtraBars.v21.2">
      <HintPath>C:\Program Files (x86)\DevExpress 21.2\Components\Bin\Framework\DevExpress.XtraBars.v21.2.dll</HintPath>
    </Reference>
    <Reference Include="DevExpress.XtraEditors.v21.2">
      <HintPath>C:\Program Files (x86)\DevExpress 21.2\Components\Bin\Framework\DevExpress.XtraEditors.v21.2.dll</HintPath>
    </Reference>
    <Reference Include="DevExpress.XtraGrid.v21.2">
      <HintPath>C:\Program Files (x86)\DevExpress 21.2\Components\Bin\Framework\DevExpress.XtraGrid.v21.2.dll</HintPath>
    </Reference>
    <Reference Include="DevExpress.XtraLayout.v21.2">
      <HintPath>C:\Program Files (x86)\DevExpress 21.2\Components\Bin\Framework\DevExpress.XtraLayout.v21.2.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- WYNLAB.BaseForm/WYNLAB.Controls/WYNLAB.Shared를 ProjectReference(소스 참조, 매번 같이
       재빌드)가 아니라 이미 빌드된 DLL을 직접 참조하는 방식으로 바꿨다 - 화면 프로젝트 쪽에서
       프레임워크 프로젝트를 빌드하지 않게 분리하는 게 목적. 대신 이 DLL들을 고쳤으면 그
       프로젝트를 먼저 빌드해서 아래 경로의 DLL을 최신으로 만들어둔 다음에 이 프로젝트를
       빌드해야 한다(자동으로 안 따라옴) - ProjectReference였을 때와 달라진 점.

       Private=false(CopyLocal 끔)를 꼭 줘야 한다 - 안 주면 컴파일에만 쓰고 마는 게 아니라
       이 DLL들을 이 프로젝트 자신의 bin 폴더에도 그대로 복사해버려서, "화면 모듈은 프레임워크
       dll을 자기 걸로 따로 안 갖고 참조만 한다"는 원래 목적이 무색해진다. 런타임에는 문제
       없다 - 이 모듈(WYNLAB.SM.frmMinorCode.dll)은 Shell.exe와 같은 AppDomain에 Assembly.LoadFrom으로
       로드되는데, Shell.exe가 자기 ProjectReference로 이미 이 dll들을 로드해둔 상태라 CLR이
       동일 어셈블리 아이덴티티를 재사용한다(CoreAssemblyUpdater가 애초에 이 셋을 중앙 관리
       하는 전제와 같은 논리) - Modules 폴더에도 원래 이 dll들이 안 실렸던 것과 동일한 이유. -->
  <ItemGroup>
    <Reference Include="WYNLAB.BaseForm">
      <HintPath>..\..\..\..\01.Client\WYNLAB.BaseForm\bin\Debug\net48\WYNLAB.BaseForm.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="WYNLAB.Controls">
      <HintPath>..\..\..\..\01.Client\WYNLAB.Controls\bin\Debug\net48\WYNLAB.Controls.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="WYNLAB.Shared">
      <HintPath>..\..\..\..\03.Shared\WYNLAB.Shared\bin\Debug\netstandard2.0\WYNLAB.Shared.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- SDK 스타일 프로젝트는 보통 frmMinorCode.cs/.Designer.cs/.resx 이름만 맞으면 자동으로
       "이건 폼이다"를 인식해서 우클릭 메뉴에 "디자이너 보기"를 띄워주는데, 이 프로젝트에서는
       그 자동인식이 안 걸려서 명시적으로 지정해준다 - SubType=Form이 VS가 디자이너를 보여줄지
       판단하는 핵심 플래그, DependentUpon이 .Designer.cs/.resx를 frmMinorCode.cs 밑에
       중첩시키는(솔루션 탐색기에서 화살표로 펼쳐지게) 연결 정보다. -->
  <ItemGroup>
    <Compile Update="frmMinorCode.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="frmMinorCode.Designer.cs">
      <DependentUpon>frmMinorCode.cs</DependentUpon>
    </Compile>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Update="frmMinorCode.resx">
      <DependentUpon>frmMinorCode.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <!-- 이 프로젝트는 99.SOURCE\SM\{화면명}\에 있는 자기 전용 .sln에서 빌드되므로, SolutionDir 기준
       상대경로도 그에 맞춰(리포 루트까지 세 단계 위) 잡는다.

       System.Resources.Extensions.dll도 같이 복사해야 한다 - SvgIcon처럼 문자열이 아닌 리소스가
       .resx에 있으면(GenerateResourceUsePreserializedResources) 런타임에 ResourceManager가 이
       dll을 Type.GetType으로 찾는데, Modules\ 폴더에는 이 프로젝트의 dll/pdb만 올라가다 보니
       실제 서버 배포 후 메뉴를 열면 FileNotFoundException으로 죽는 문제가 있었다(로컬 개발 PC는
       이 dll이 이 프로젝트 자신의 bin 폴더에 항상 같이 있어서 안 드러났음) - WYNLAB.BaseForm/
       WYNLAB.Controls처럼 Shell.exe가 자체적으로 들고 있는 공용 dll이 아니라 이 화면만 필요로
       하는 의존성이라, Modules\SM\ 폴더에 직접 실어야 한다. -->
  <Target Name="CopyToModulesFolder" AfterTargets="Build">
    <ItemGroup>
      <ModuleOutputFiles Include="$(TargetDir)$(TargetName).dll" />
      <ModuleOutputFiles Include="$(TargetDir)$(TargetName).pdb" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
      <ModuleOutputFiles Include="$(TargetDir)System.Resources.Extensions.dll" Condition="Exists('$(TargetDir)System.Resources.Extensions.dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(ModuleOutputFiles)" DestinationFolder="$(SolutionDir)..\..\..\01.Client\WYNLAB.Shell\bin\$(Configuration)\net48\Modules\" SkipUnchangedFiles="true" />
  </Target>

</Project>
