<Project Sdk="Microsoft.NET.Sdk">

  <!-- 모듈(MA) 하나가 프로젝트 하나고 DLL 하나다. 이 모듈 안에서 화면은 서로
       독립된 서브모듈(각 화면 폴더)로만 폴더로 구분한다 - 나중에 이 모듈을 쪼개거나 화면을
       다른 서브모듈로 옮길 때 폴더만 옮기면 되고 TSMMENU.FORM_CLASS_NM은 안 건드려도 된다.

       화면 하나당 프로젝트 하나였던 방식(WYNLAB.SM이 처음 그랬듯)에서 바꿨다 - 화면이
       수백 개면 배포 스크립트가 프로젝트 수만큼 빌드를 따로 해야 하고(화면 300개면 300번),
       배포 파일도 dll+pdb만 600개가 된다. 모듈 단위로 묶으면 그게 모듈 수(10개 안팎)로
       줄어든다. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- 폴더(화면명)만 네임스페이스에 반영되지 않는다 - 폴더는 사람이 찾기 쉬우라고 나누는
         것이고, 네임스페이스까지 따라 나뉘면 화면을 다른 폴더로 옮길 때마다 그 화면의
         TSMMENU 값이 같이 바뀐다. -->
    <RootNamespace>WYNLAB.MA</RootNamespace>
    <AssemblyName>WYNLAB.MA</AssemblyName>

    <!-- SvgIcon처럼 문자열이 아닌(이미지 등) 리소스가 .resx에 있으면 SDK 스타일 프로젝트는
         기본적으로 못 담는다 - 이 옵션 + System.Resources.Extensions 패키지가 있어야 된다. -->
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Resources.Extensions" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- DevExpress 21.2 로컬 설치 기반 참조 -->
    <Reference Include="DevExpress.Data.v21.2">
      <HintPath>C:\Program Files (x86)\DevExpress 21.2\Components\Bin\Framework\DevExpress.Data.v21.2.dll</HintPath>
    </Reference>
    <!-- GridControl/GridView를 ISupportInitialize로 캐스트(BeginInit/EndInit, 디자이너 초기화
         패턴)하려면 필요 - Data.v21.2만으로는 GridControl의 전체 타입 계층(IControlRowSource 등)을
         컴파일러가 다 못 찾는다. -->
    <Reference Include="DevExpress.Data.Desktop.v21.2">
      <HintPath>C:\Program Files (x86)\DevExpress 21.2\Components\Bin\Framework\DevExpress.Data.Desktop.v21.2.dll</HintPath>
    </Reference>
    <Reference Include="DevExpress.Utils.v21.2">
      <HintPath>C:\Program Files (x86)\DevExpress 21.2\Components\Bin\Framework\DevExpress.Utils.v21.2.dll</HintPath>
    </Reference>
    <Reference Include="DevExpress.XtraBars.v21.2">
      <HintPath>C:\Program Files (x86)\DevExpress 21.2\Components\Bin\Framework\DevExpress.XtraBars.v21.2.dll</HintPath>
    </Reference>
    <Reference Include="DevExpress.XtraEditors.v21.2">
      <HintPath>C:\Program Files (x86)\DevExpress 21.2\Components\Bin\Framework\DevExpress.XtraEditors.v21.2.dll</HintPath>
    </Reference>
    <Reference Include="DevExpress.XtraGrid.v21.2">
      <HintPath>C:\Program Files (x86)\DevExpress 21.2\Components\Bin\Framework\DevExpress.XtraGrid.v21.2.dll</HintPath>
    </Reference>
    <!-- BaseForm.ConfirmMasterRowSwitch/SuppressMasterRowSwitchConfirm에 TreeList 오버로드가 있어서, 마스터 행 전환
         확인을 쓰는 화면(frmPoPrice)을 컴파일하려면 이 참조가 필요하다(2026-09-26). -->
    <Reference Include="DevExpress.XtraTreeList.v21.2">
      <HintPath>C:\Program Files (x86)\DevExpress 21.2\Components\Bin\Framework\DevExpress.XtraTreeList.v21.2.dll</HintPath>
    </Reference>
    <Reference Include="DevExpress.XtraLayout.v21.2">
      <HintPath>C:\Program Files (x86)\DevExpress 21.2\Components\Bin\Framework\DevExpress.XtraLayout.v21.2.dll</HintPath>
    </Reference>
    <!-- 이 모듈의 화면 중 TreeList(권한부여 같은 트리 UI)를 쓰는 화면이 생기면 SM처럼
         DevExpress.XtraTreeList.v21.2 참조를 여기에 추가할 것. -->
  </ItemGroup>

  <!-- WYNLAB.BaseForm/WYNLAB.Controls/WYNLAB.Shared를 ProjectReference(소스 참조, 매번 같이
       리빌드)가 아니라 이미 빌드된 DLL을 직접 참조한다 - 화면 프로젝트가 프레임워크 프로젝트를
       빌드하지 않게 분리하는 게 목적. 저 셋의 DLL들을 고쳤다면 그 프로젝트를 먼저 빌드해서
       아래 경로의 DLL을 최신으로 만들어둔 다음에야 이 프로젝트를 빌드해야 한다(자동으로 안 딸려온다).

       Private=false(CopyLocal 끔)를 줘야 한다 - 켜주면 이 DLL들을 이 프로젝트 bin 폴더에도
       복사해버려서, "화면 모듈은 프레임워크 dll을 참조만 한다"는 목적이 무색해진다. 실제로도
       문제 있다 - 이 모듈은 Shell.exe와 같은 AppDomain에 로드되고 Shell.exe가 이미 그 dll들을
       쥐고 있어서 CLR은 동일 어셈블리로 취급한다(CoreAssemblyUpdater가 그걸 중앙 관리하는
       전제와 같은 원리). -->
  <ItemGroup>
    <Reference Include="WYNLAB.BaseForm">
      <HintPath>..\..\..\00.DEV\01.Client\WYNLAB.BaseForm\bin\Debug\net48\WYNLAB.BaseForm.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="WYNLAB.Controls">
      <HintPath>..\..\..\00.DEV\01.Client\WYNLAB.Controls\bin\Debug\net48\WYNLAB.Controls.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="WYNLAB.Shared">
      <HintPath>..\..\..\00.DEV\03.Shared\WYNLAB.Shared\bin\Debug\netstandard2.0\WYNLAB.Shared.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 파일첨부/전자결재 등 공용 팝업(어떤 모듈에도 속하지 않는 화면) - 00.DEV/MODULE_ARCHITECTURE.md -->
    <Reference Include="WYNLAB.Popup">
      <HintPath>..\..\POPUP\WYNLAB.Popup\bin\Debug\net48\WYNLAB.Popup.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- SDK 스타일 프로젝트는 보통 이름만 맞으면 "이건 이미 다 자동 인식되는" 파일도 있지만,
       WinForms 디자이너는 가끔 못 걸려서 명시한다 - SubType=Form이 VS가 디자이너로 보여줄지
       판단하는 핵심 플래그, DependentUpon이 .Designer.cs/.resx를 그 파일 밑에 중첩시키는 연결
       정보다. 화면을 추가할 때마다 아래 세 줄씩 여기 이 ItemGroup에 늘어놓는다(WYNLAB.SM.csproj와
       같은 패턴 - 없으면 MissingManifestResourceException으로 죽는다, frmUserAuth에서 실제로 겪음). -->
  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

