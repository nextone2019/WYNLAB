<Project Sdk="Microsoft.NET.Sdk">

  <!-- 모듈(BA = 기준정보?) 하나가 프로젝트 하나고 DLL 하나다. 이 모듈 안에서 화면은 서로
       독립된 서브모듈(각 화면 폴더)로만 폴더로 구분한다 - 나중에 이 모듈을 쪼개거나 화면을
       다른 서브모듈로 옮길 때 폴더만 옮기면 되고 TSMMENU.FORM_CLASS_NM은 안 건드려도 된다.

       화면 하나당 프로젝트 하나였던 방식(WYNLAB.SM이 처음 그랬듯)에서 바꿨다 - 화면이
       수백 개면 배포 스크립트가 프로젝트 수만큼 빌드를 따로 해야 하고(화면 300개면 300번),
       배포 파일도 dll+pdb만 600개가 된다. 모듈 단위로 묶으면 그게 모듈 수(10개 안팎)로
       줄어든다. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- 폴더(화면명)만 네임스페이스에 반영되지 않는다 - 폴더는 사람이 찾기 쉬우라고 나누는
         것이고, 네임스페이스까지 따라 나뉘면 화면을 다른 폴더로 옮길 때마다 그 화면의
         TSMMENU 값이 같이 바뀐다. -->
    <RootNamespace>WYNLAB.BA</RootNamespace>
    <AssemblyName>WYNLAB.BA</AssemblyName>

    <!-- SvgIcon처럼 문자열이 아닌(이미지 등) 리소스가 .resx에 있으면 SDK 스타일 프로젝트는
         기본적으로 못 담는다 - 이 옵션 + System.Resources.Extensions 패키지가 있어야 된다. -->
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Resources.Extensions" Version="8.0.0" />
  </ItemGroup>

