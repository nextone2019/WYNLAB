<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <!-- assemblyIdentity를 여기 넣으면 안 된다 - ClickOnce가 WYNLAB.exe를 type="win32"
       종속 어셈블리로 취급하면서, 배포 매니페스트가 선언한 identity(name="WYNLAB.exe",
       version=그때그때 배포판마다 다른 ApplicationVersion)와 이 안에 고정으로 박힌
       identity(name="WYNLAB.app", version="1.0.0.0")를 비교해서 RefDefValidation
       (매니페스트의 참조가 다운로드한 어셈블리 WYNLAB.exe의 ID와 일치하지 않습니다)로
       매번 설치가 깨졌다(2026-09-14, 배포판/캐시를 몇 번을 새로 만들어도 재현됨 - 서버가
       내려주는 파일 자체는 해시까지 전부 정상이었는데 이게 원인이었음). UAC/DPI 선언만
       필요한 이 앱의 exe 자체 매니페스트에는 assemblyIdentity가 필요 없다(SxS 공유
       컴포넌트 매니페스트에만 필요한 요소) - 없어야 ClickOnce가 배포 매니페스트의
       identity를 그대로 신뢰한다. -->

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 7/8/8.1/10/11 -->
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}"/>
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}"/>
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
      <supportedOS Id="{e2011457-1546-43c5-a5fe-008deee3d3f0}"/>
    </application>
  </compatibility>

  <!--
    DPI 인식 선언. 이게 없으면 Windows가 창 전체를 비트맵으로 확대해서 그려
    (배율 125%/150% 등 설정된 모니터에서) GDI+로 직접 그린 아이콘과 글자가
    전부 흐릿하게(깨져) 보인다. System DPI Aware로 지정해 선명하게 렌더링되도록 함.
    (PerMonitorV2가 아닌 System을 쓰는 이유: 이 프로젝트 화면들이 고정 픽셀 좌표로
    수동 배치되어 있어, 모니터 이동 시 실시간 재조정까지 필요한 PerMonitorV2는
    레이아웃이 깨질 위험이 있음. System 모드는 시작 시 1회만 스케일을 적용해 안전함.)
  -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true</dpiAware>
    </windowsSettings>
  </application>
</assembly>
