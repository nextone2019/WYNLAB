<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>WYNLAB.Shell</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- DevExpress 20.2 로컬 설치 기반 참조 -->
    <Reference Include="DevExpress.Data.v20.2">
      <HintPath>C:\Program Files (x86)\DevExpress 20.2\Components\Bin\Framework\DevExpress.Data.v20.2.dll</HintPath>
    </Reference>
    <Reference Include="DevExpress.Utils.v20.2">
      <HintPath>C:\Program Files (x86)\DevExpress 20.2\Components\Bin\Framework\DevExpress.Utils.v20.2.dll</HintPath>
    </Reference>
    <Reference Include="DevExpress.XtraBars.v20.2">
      <HintPath>C:\Program Files (x86)\DevExpress 20.2\Components\Bin\Framework\DevExpress.XtraBars.v20.2.dll</HintPath>
    </Reference>
    <Reference Include="DevExpress.XtraEditors.v20.2">
      <HintPath>C:\Program Files (x86)\DevExpress 20.2\Components\Bin\Framework\DevExpress.XtraEditors.v20.2.dll</HintPath>
    </Reference>
    <Reference Include="DevExpress.XtraGrid.v20.2">
      <HintPath>C:\Program Files (x86)\DevExpress 20.2\Components\Bin\Framework\DevExpress.XtraGrid.v20.2.dll</HintPath>
    </Reference>
    <Reference Include="DevExpress.XtraLayout.v20.2">
      <HintPath>C:\Program Files (x86)\DevExpress 20.2\Components\Bin\Framework\DevExpress.XtraLayout.v20.2.dll</HintPath>
    </Reference>
    <!-- 앱 전체 스킨(메시지박스 포함 모든 DevExpress 컨트롤의 색/테두리/캡션)을 위해 필요 -->
    <Reference Include="DevExpress.BonusSkins.v20.2">
      <HintPath>C:\Program Files (x86)\DevExpress 20.2\Components\Bin\Framework\DevExpress.BonusSkins.v20.2.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WYNLAB.UI.Common\WYNLAB.UI.Common.csproj" />
    <ProjectReference Include="..\WYNLAB.Modules.System\WYNLAB.Modules.System.csproj" />
    <ProjectReference Include="..\..\03.Shared\WYNLAB.Shared\WYNLAB.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 빌드 구성에 따라 다른 서버를 바라보도록 환경별 설정파일을 분리.
         Debug 빌드(사장님/개발자 평소 F5) -> 개발서버
         Release 빌드(ClickOnce 운영 게시) -> 운영서버
         둘 다 출력폴더에는 동일하게 "appsettings.json" 이름으로 복사됨(Link) -->
    <None Include="appsettings.Dev.json" Link="appsettings.json" Condition="'$(Configuration)'=='Debug'">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="appsettings.Prod.json" Link="appsettings.json" Condition="'$(Configuration)'=='Release'">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
