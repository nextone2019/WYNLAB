<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <!-- Prod.pubxml과 내용은 같은데, 서버로 직접 업로드하는 대신 로컬에 게시해서 그
         결과물을 수동으로 서버(D:\WYNLAB\ClickOnce\)에 복사하는 용도.

         WYNLAB.Shell이 SDK 스타일 .NET Framework 프로젝트라, VS의 새 "게시" 화면(우클릭 ->
         게시)에는 ClickOnce 옵션 자체가 없다(.NET 5+ 프로젝트에만 지원됨) - 그래서 VS GUI
         대신 MSBuild.exe로 직접 게시해야 한다:
           & "<VS설치경로>\MSBuild\Current\Bin\amd64\MSBuild.exe" WYNLAB.Shell.csproj /t:Publish /p:PublishProfile=ProdLocal
         PublishProtocol/GenerateManifests/SignManifests 세 줄이 CLI에서 진짜 ClickOnce
         파이프라인을 타게 만드는 핵심이다(이게 없으면 조용히 일반 파일복사 게시로 빠진다).

         PublishUrl은 실제로는 무시되고, 결과물은 항상 고정된 위치
         (bin\Release\net48\publish\, WYNLAB.application + Application Files\ 포함)에 나온다 -
         그 폴더 통째로 서버에 복사하면 된다. InstallUrl(매니페스트 안에 박히는 "여기서
         업데이트 확인해라" 주소)만 실제 서버 주소로 정확히 반영된다(직접 확인함). -->
    <PublishProtocol>ClickOnce</PublishProtocol>
    <GenerateManifests>true</GenerateManifests>
    <SignManifests>false</SignManifests>
    <InstallUrl>http://221.150.162.198:8091/</InstallUrl>
    <Configuration>Release</Configuration>
    <ProductName>WYN LAB</ProductName>
    <PublisherName>[회사명]</PublisherName>
    <ApplicationVersion>1.0.0.*</ApplicationVersion>
    <Install>true</Install>
    <UpdateEnabled>true</UpdateEnabled>
    <!-- Foreground = 앱이 뜨기 전에 업데이트를 확인한다(뒤늦게 받아서 "다음 실행부터 적용"이
         되지 않도록). 여기에 더해 Deploy-Package.ps1이 게시할 때 UpdateRequired=true와
         MinimumRequiredVersion(=이번 게시 버전)을 같이 넘겨서 "필수 업데이트"로 만든다 -
         그래야 "지금 다운로드하시겠습니까? [건너뛰기]" 창 없이 바로 받고 재시작한다.
         그 두 값을 여기 두지 않은 이유는 Deploy-Package.ps1의 해당 주석 참고. -->
    <UpdateMode>Foreground</UpdateMode>
    <!-- true여야 Application Files\ 안의 .exe/.config/.manifest 파일들이 .deploy로
         이름이 바뀌어서 게시된다 - IIS가 .config/.exe 같은 확장자를 보안상 기본 차단하기
         때문에(실제로 WYNLAB.exe.config가 404났었음), .deploy로 우회해야 한다. 서버의
         ClickOnce 사이트에 .deploy MIME 타입을 등록해둔 것(SERVER_SETUP.md 5번)이 바로
         이 설정과 짝이 맞아야 동작한다. -->
    <MapFileExtensions>true</MapFileExtensions>
  </PropertyGroup>
</Project>
