  <!-- WYNLAB.BaseForm/WYNLAB.Controls/WYNLAB.Shared를 ProjectReference(소스 참조, 매번 같이
       리빌드)가 아니라 이미 빌드된 DLL을 직접 참조한다 - 화면 프로젝트가 프레임워크 프로젝트를
       빌드하지 않게 분리하는 게 목적. 저 셋의 DLL들을 고쳤다면 그 프로젝트를 먼저 빌드해서
       아래 경로의 DLL을 최신으로 만들어둔 다음에야 이 프로젝트를 빌드해야 한다(자동으로 안 딸려온다).

       Private=false(CopyLocal 끔)를 줘야 한다 - 켜주면 이 DLL들을 이 프로젝트 bin 폴더에도
       복사해버려서, "화면 모듈은 프레임워크 dll을 참조만 한다"는 목적이 무색해진다. 실제로도
       문제 있다 - 이 모듈은 Shell.exe와 같은 AppDomain에 로드되고 Shell.exe가 이미 그 dll들을
       쥐고 있어서 CLR은 동일 어셈블리로 취급한다(CoreAssemblyUpdater가 그걸 중앙 관리하는
       전제와 같은 원리). -->
  <ItemGroup>
    <Reference Include="WYNLAB.BaseForm">
      <HintPath>..\..\..\00.DEV\01.Client\WYNLAB.BaseForm\bin\Debug\net48\WYNLAB.BaseForm.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="WYNLAB.Controls">
      <HintPath>..\..\..\00.DEV\01.Client\WYNLAB.Controls\bin\Debug\net48\WYNLAB.Controls.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="WYNLAB.Shared">
      <HintPath>..\..\..\00.DEV\03.Shared\WYNLAB.Shared\bin\Debug\netstandard2.0\WYNLAB.Shared.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 파일첨부/전자결재 등 공용 팝업(어떤 모듈에도 속하지 않는 화면) - 00.DEV/MODULE_ARCHITECTURE.md -->
    <Reference Include="WYNLAB.Popup">
      <HintPath>..\..\POPUP\WYNLAB.Popup\bin\Debug\net48\WYNLAB.Popup.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- SDK 스타일 프로젝트는 보통 이름만 맞으면 "이건 이미 다 자동 인식되는" 파일도 있지만,
       WinForms 디자이너는 가끔 못 걸려서 명시한다 - SubType=Form이 VS가 디자이너로 보여줄지
       판단하는 핵심 플래그, DependentUpon이 .Designer.cs/.resx를 그 파일 밑에 중첩시키는 연결
       정보다. 화면을 추가할 때마다 아래 세 줄씩 여기 이 ItemGroup에 늘어놓는다(WYNLAB.SM.csproj와
       같은 패턴 - 없으면 MissingManifestResourceException으로 죽는다, frmUserAuth에서 실제로 겪음). -->
  <ItemGroup>

    <!-- frmAcc.resx는 2026-09-11 사용자가 VS 디자이너에서 SectionHeaderWyn에 SvgIcon을 추가하면서
         새로 생겼다(예전엔 코드 아이콘만 써서 정말 resx가 없었음, 아래 EmbeddedResource 항목도
         그때는 없었다) - DependentUpon 연결이 없으면 MSBuild가 "폴더\타입명" 기준 기본 규칙으로
         잘못된 매니페스트 리소스 이름(WYNLAB.BA.frmAcc.frmAcc.resources, "타입명."이 중복됨)을
         만들어서, ComponentResourceManager(typeof(frmAcc))가 찾는 이름(WYNLAB.BA.frmAcc.resources)과
         어긋나 MissingManifestResourceException으로 화면이 아예 안 열렸다(실제로 겪음) -
         frmDept/frmEMP 등 다른 폼과 같은 패턴으로 맞춘다. -->
    <Compile Update="frmAcc\frmAcc.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="frmAcc\frmAcc.Designer.cs">
      <DependentUpon>frmAcc.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="frmAcc\frmAcc.resx">
      <DependentUpon>frmAcc.cs</DependentUpon>
    </EmbeddedResource>

    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <!-- 빌드 결과를 Shell의 Modules 폴더로 복사해서, 개발 중에 F5를 누르면 바로 최신 화면이
       뜨게 한다. System.Resources.Extensions.dll도 같이 복사해야 한다 - SvgIcon처럼 문자열이
       아닌 리소스가 .resx에 있으면 런타임에 ResourceManager가 이 dll을 찾는다(Modules 폴더에
       없으면 서버 배포 시 메뉴를 열 때 FileNotFoundException으로 죽는다, 개발 PC에는 이
       dll이 여기 bin에 같이 있어서 안 걸러졌음). -->
  <Target Name="CopyToModulesFolder" AfterTargets="Build">
    <ItemGroup>
      <ModuleOutputFiles Include="$(TargetDir)$(TargetName).dll" />
      <ModuleOutputFiles Include="$(TargetDir)$(TargetName).pdb" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
      <ModuleOutputFiles Include="$(TargetDir)System.Resources.Extensions.dll" Condition="Exists('$(TargetDir)System.Resources.Extensions.dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(ModuleOutputFiles)" DestinationFolder="$(SolutionDir)..\..\00.DEV\01.Client\WYNLAB.Shell\bin\$(Configuration)\net48\Modules\" SkipUnchangedFiles="true" />
  </Target>

